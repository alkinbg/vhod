{% extends 'base.html.twig' %}

{% block title %}Начало · Vhod{% endblock %}

{% block body %}
<section class="hero">
    <div>
        <p class="eyebrow">Нашият вход</p>
        <h1>Здравей{% if person %}, {{ person.firstName }}{% endif %}.</h1>
        <p class="muted">Всичко важно за входа на едно място.</p>
    </div>
</section>

<section class="grid">
    <article class="card highlight">
        <span>Моето салдо</span>
        <strong>{{ (total_balance_cents / 100)|number_format(2, '.', '') }} €</strong>
        <small>Общо за активните обекти, свързани с профила ви.</small>
        <a class="button-link secondary-button" href="{{ path('app_book') }}">Моята книга</a>
    </article>
    <article class="card">
        <span>Моите обекти</span>
        <strong>{{ unit_balances|length }}</strong>
        {% if unit_balances %}
            <small>{% for row in unit_balances %}{% if not loop.first %}, {% endif %}{{ row.unit.designation }}{% endfor %}</small>
        {% else %}
            <small>Няма активен собственик/ползвател, свързан с профила.</small>
        {% endif %}
    </article>
    <article class="card">
        <span>Активни сигнали</span>
        <strong data-testid="active-maintenance-count">{{ active_signal_count }}</strong>
        <small>Отворени, в работа или изчакващи сигнали, подадени от вас.</small>
        <a class="button-link secondary-button" href="{{ path('app_maintenance_index') }}">Поддръжка</a>
    </article>
    <article class="card official-card general-assembly-dashboard-card">
        <span>Официално</span>
        <strong>Общи събрания</strong>
        <small>Покани, дневен ред, решения и финализирани протоколи.</small>
        <a class="button-link secondary-button" href="{{ path('app_assemblies_index') }}">Виж събранията</a>
    </article>
</section>

<section class="columns">
    <article class="panel">
        <div class="panel-title"><div><p class="eyebrow">Общност</p><h2>Какво обсъждат съседите</h2></div><span class="badge">Активно</span></div>
        <p class="muted">Публикации, идеи и взаимопомощ между хората от входа.</p>
        <a class="button-link secondary-button" href="{{ path('app_community_index') }}">Към общността</a>
    </article>
    {% set unreadCount = announcement_unread_count() %}
    <article class="panel official-dashboard-card official-card">
        <div class="panel-title">
            <div>
                <p class="eyebrow">Официално</p>
                <h2>Официални обяви</h2>
            </div>
            {% if unreadCount > 0 %}
                <span class="badge unread-badge">{{ unreadCount }} непрочетени</span>
            {% else %}
                <span class="badge badge--official">Актуално</span>
            {% endif %}
        </div>
        <p class="muted">Публикувани съобщения от управлението на входа, отделени от разговорите в общността.</p>
        <div class="official-actions">
            <a class="button-link" href="{{ path('app_announcements_index') }}">Виж обявите</a>
            <a class="button-link secondary-button" href="{{ path('app_documents_index') }}">Документи</a>
        </div>
    </article>
</section>
{% endblock %}
