{% extends 'base.html.twig' %}

{% block title %}Начало · Vhod{% endblock %}

{% block body %}
<section class="hero">
    <div>
        <p class="eyebrow">Нашият вход</p>
        <h1>Здравей{% if person %}, {{ person.firstName }}{% endif %}.</h1>
        <p class="muted">Всичко важно за входа на едно място.</p>
    </div>
</section>

<section class="grid">
    <article class="card highlight"><span>Моето задължение</span><strong>—</strong><small>Финансовият модул е следващият етап.</small></article>
    <article class="card"><span>Фонд „Ремонт и обновяване“</span><strong>—</strong></article>
    <article class="card"><span>Активни сигнали</span><strong>0</strong></article>
    <article class="card official-card general-assembly-dashboard-card">
        <span>Официално</span>
        <strong>Общи събрания</strong>
        <small>Покани, дневен ред, решения и финализирани протоколи.</small>
        <a class="button-link secondary-button" href="{{ path('app_assemblies_index') }}">Виж събранията</a>
    </article>
</section>

<section class="columns">
    <article class="panel">
        <div class="panel-title"><div><p class="eyebrow">Общност</p><h2>Какво обсъждат съседите</h2></div><span class="badge">Скоро</span></div>
        <p class="muted">Публикации, идеи, взаимопомощ, анкети и събития — само за хората от входа.</p>
    </article>
    {% set unreadCount = announcement_unread_count() %}
    <article class="panel official-dashboard-card official-card">
        <div class="panel-title">
            <div>
                <p class="eyebrow">Официално</p>
                <h2>Официални обяви</h2>
            </div>
            {% if unreadCount > 0 %}
                <span class="badge unread-badge">{{ unreadCount }} непрочетени</span>
            {% else %}
                <span class="badge badge--official">Актуално</span>
            {% endif %}
        </div>
        <p class="muted">Публикувани съобщения от управлението на входа, отделени от разговорите в общността.</p>
        <div class="official-actions">
            <a class="button-link" href="{{ path('app_announcements_index') }}">Виж обявите</a>
            <a class="button-link secondary-button" href="{{ path('app_documents_index') }}">Документи</a>
        </div>
    </article>
</section>
{% endblock %}
