{% extends 'base.html.twig' %}

{% block title %}Начало · Vhod{% endblock %}

{% block body %}
<div class="page-header d-print-none mb-4">
    <div class="row align-items-center g-3">
        <div class="col">
            <div class="page-pretitle">Нашият вход</div>
            <h1 class="page-title">Здравей{% if person %}, {{ person.firstName }}{% endif %}.</h1>
            <div class="text-secondary mt-1">Най-важното за дома и общността ви на едно място.</div>
        </div>
    </div>
</div>

{% set unreadCount = announcement_unread_count() %}
<div class="row row-deck row-cards mb-4" data-testid="resident-dashboard-summary">
    <div class="col-sm-6 col-xl-3">
        <article class="card h-100">
            <div class="card-status-top bg-primary"></div>
            <div class="card-body">
                <div class="subheader mb-2">Моето салдо</div>
                <div class="h1 mb-1">{{ (total_balance_cents / 100)|number_format(2, '.', '') }} €</div>
                <div class="text-secondary small">Общо за активните обекти в профила</div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a class="link-primary fw-semibold" href="{{ path('app_book') }}">Моята книга →</a>
            </div>
        </article>
    </div>

    <div class="col-sm-6 col-xl-3">
        <article class="card h-100">
            <div class="card-body">
                <div class="subheader mb-2">Моите обекти</div>
                <div class="h1 mb-1">{{ unit_balances|length }}</div>
                {% if unit_balances %}
                    <div class="text-secondary small text-truncate">
                        {% for row in unit_balances %}{% if not loop.first %}, {% endif %}{{ row.unit.designation }}{% endfor %}
                    </div>
                {% else %}
                    <div class="text-secondary small">Няма свързан активен обект</div>
                {% endif %}
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a class="link-secondary fw-semibold" href="{{ path('app_book') }}">Данни за обектите →</a>
            </div>
        </article>
    </div>

    <div class="col-sm-6 col-xl-3">
        <article class="card h-100">
            <div class="card-body">
                <div class="subheader mb-2">Активни сигнали</div>
                <div class="h1 mb-1" data-testid="active-maintenance-count">{{ active_signal_count }}</div>
                <div class="text-secondary small">Отворени или все още обработвани от вас</div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a class="link-secondary fw-semibold" href="{{ path('app_maintenance_index') }}">Към поддръжката →</a>
            </div>
        </article>
    </div>

    <div class="col-sm-6 col-xl-3">
        <article class="card h-100">
            {% if unreadCount > 0 %}<div class="card-status-top bg-danger"></div>{% endif %}
            <div class="card-body">
                <div class="subheader mb-2">Непрочетени обяви</div>
                <div class="h1 mb-1">{{ unreadCount }}</div>
                <div class="text-secondary small">Официални съобщения от управлението</div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a class="link-{% if unreadCount > 0 %}danger{% else %}secondary{% endif %} fw-semibold" href="{{ path('app_announcements_index') }}">Виж обявите →</a>
            </div>
        </article>
    </div>
</div>

<div class="d-flex align-items-center mb-3">
    <div>
        <div class="subheader">Бърз достъп</div>
        <h2 class="h3 mb-0">Входът отблизо</h2>
    </div>
</div>

<div class="row row-cards" data-testid="resident-dashboard-sections">
    <div class="col-md-6 col-xl-4">
        <article class="card h-100">
            <div class="card-header">
                <div>
                    <div class="subheader">Официално</div>
                    <h2 class="card-title mt-1">Общи събрания</h2>
                </div>
                <span class="badge bg-primary-lt ms-auto">Решения</span>
            </div>
            <div class="card-body">
                <p class="text-secondary mb-0">Покани, дневен ред, приети решения и финализирани протоколи.</p>
            </div>
            <div class="card-footer bg-transparent">
                <a class="btn btn-outline-primary" href="{{ path('app_assemblies_index') }}">Виж събранията</a>
            </div>
        </article>
    </div>

    <div class="col-md-6 col-xl-4">
        <article class="card h-100">
            <div class="card-header">
                <div>
                    <div class="subheader">Съседи</div>
                    <h2 class="card-title mt-1">Общност</h2>
                </div>
                <span class="badge bg-secondary-lt ms-auto">Неофициално</span>
            </div>
            <div class="card-body">
                <p class="text-secondary mb-0">Разговори, идеи, взаимопомощ, събития и неформални анкети между съседи.</p>
            </div>
            <div class="card-footer bg-transparent">
                <a class="btn btn-outline-secondary" href="{{ path('app_community_index') }}">Към общността</a>
            </div>
        </article>
    </div>

    <div class="col-md-6 col-xl-4">
        <article class="card h-100">
            <div class="card-header">
                <div>
                    <div class="subheader">Архив</div>
                    <h2 class="card-title mt-1">Документи</h2>
                </div>
            </div>
            <div class="card-body">
                <p class="text-secondary mb-0">Правилници, протоколи и други документи, до които имате достъп.</p>
            </div>
            <div class="card-footer bg-transparent">
                <a class="btn btn-outline-secondary" href="{{ path('app_documents_index') }}">Отвори документите</a>
            </div>
        </article>
    </div>
</div>
{% endblock %}
