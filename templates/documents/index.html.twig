{% extends 'base.html.twig' %}

{% block title %}Документи · Vhod{% endblock %}

{% block body %}
<section class="hero">
    <div>
        <p class="eyebrow">Официални документи</p>
        <h1>Документи</h1>
        <p class="muted">Преглед и изтегляне на документите, до които имате достъп.</p>
    </div>
</section>

<div class="panel">
    <form method="get" action="{{ path('app_documents_index') }}" class="form-grid">
        <label>Категория
            <select name="category">
                <option value="">Всички категории</option>
                {% for category in categories %}
                    <option value="{{ category.value }}"{% if selected_category is same as(category) %} selected{% endif %}>{{ category.labelBg() }}</option>
                {% endfor %}
            </select>
        </label>
        <div><button class="button" type="submit">Филтрирай</button></div>
    </form>
</div>

<div class="panel">
    {% if documents is empty %}
        <p class="muted">Няма достъпни документи.</p>
    {% else %}
        <div class="table-wrap">
            <table>
                <thead><tr><th>Документ</th><th>Категория</th><th>Достъп</th><th>Качен</th><th></th></tr></thead>
                <tbody>
                {% for document in documents %}
                    <tr>
                        <td><strong>{{ document.title }}</strong>{% if document.description %}<br><small class="muted">{{ document.description }}</small>{% endif %}</td>
                        <td>{{ document.category.labelBg() }}</td>
                        <td>{{ document.accessLevel.labelBg() }}</td>
                        <td>{{ document.uploadedAt|date('d.m.Y H:i', 'Europe/Sofia') }}</td>
                        <td><a class="button secondary" href="{{ path('app_document_download', {id: document.id}) }}">Изтегли</a></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
