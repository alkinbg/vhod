{% extends 'base.html.twig' %}
{% block title %}Нов приход{% endblock %}
{% block body %}
<main class="container py-4">
    <h1 class="h2">Нов приход</h1>
    {% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('finance_income_new') }}">
        <div class="mb-3"><label class="form-label">Фонд</label><select class="form-select" name="fund_id" required>{% for fund in funds %}<option value="{{ fund.id }}">{{ fund.name }}</option>{% endfor %}</select></div>
        <div class="mb-3"><label class="form-label">Категория</label><select class="form-select" name="category" required>{% for category in categories %}<option value="{{ category.value }}">{{ category.labelBg }}</option>{% endfor %}</select></div>
        <div class="mb-3"><label class="form-label">Сума (EUR)</label><input class="form-control" name="amount" inputmode="decimal" required></div>
        <div class="mb-3"><label class="form-label">Дата на получаване</label><input class="form-control" type="date" name="received_at" required></div>
        <div class="mb-3"><label class="form-label">Описание</label><input class="form-control" name="description" required></div>
        <div class="mb-3"><label class="form-label">Документ</label><input class="form-control" name="document_reference"></div>
        <div class="mb-3"><label class="form-label">Бележка</label><textarea class="form-control" name="note"></textarea></div>
        <button class="btn btn-primary" type="submit">Запиши приход</button>
        <a class="btn btn-link" href="{{ path('app_management_finance') }}">Отказ</a>
    </form>
</main>
{% endblock %}
