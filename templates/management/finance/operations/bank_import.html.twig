{% extends 'base.html.twig' %}

{% block title %}Банков импорт · Финанси{% endblock %}

{% block body %}
<section class="page-header"><div><p class="eyebrow">Финансови операции</p><h1>Импорт на CAMT.053</h1></div></section>
{% if error %}<div class="notice notice-error">{{ error }}</div>{% endif %}
<form method="post" enctype="multipart/form-data">
    <input type="hidden" name="_token" value="{{ csrf_token('finance_bank_import') }}">
    <label for="bank_account_id">Банкова сметка</label>
    <select id="bank_account_id" name="bank_account_id" required>{% for account in bank_accounts %}<option value="{{ account.id }}">{{ account.name }} · {{ account.iban }}</option>{% endfor %}</select>
    <label for="statement">CAMT.053 XML файл</label>
    <input id="statement" name="statement" type="file" accept="application/xml,text/xml,.xml" required>
    <div class="actions"><button type="submit">Импортирай извлечение</button><a href="{{ path('app_management_finance_operations') }}">Отказ</a></div>
</form>
{% endblock %}
