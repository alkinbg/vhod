{% extends 'base.html.twig' %}

{% block title %}Сторниране · Финанси{% endblock %}

{% block body %}
<main class="container py-4">
    <div class="mb-4">
        <a href="{{ path('app_management_finance') }}" class="text-decoration-none">← Назад към финансите</a>
        <h1 class="h2 mt-2">Сторниране</h1>
        <p class="text-muted mb-0">{{ kind }}: {{ description }}</p>
    </div>

    {% if error %}
        <div class="alert alert-danger" role="alert">{{ error }}</div>
    {% endif %}

    <div class="card">
        <div class="card-body">
            <p>Оригиналният запис ще остане непроменен. Ще бъде създаден отделен коригиращ запис.</p>

            <form method="post">
                <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">

                <div class="mb-3">
                    <label class="form-label" for="reason">Причина</label>
                    <textarea class="form-control" id="reason" name="reason" rows="4" required>{{ app.request.request.get('reason') }}</textarea>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-danger" type="submit">Сторнирай</button>
                    <a class="btn btn-outline-secondary" href="{{ path('app_management_finance') }}">Отказ</a>
                </div>
            </form>
        </div>
    </div>
</main>
{% endblock %}
