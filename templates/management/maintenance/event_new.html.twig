{% extends 'base.html.twig' %}

{% block title %}Ново събитие · Поддръжка · Vhod{% endblock %}

{% block body %}
<section class="hero"><div><p class="eyebrow">Управление · Поддръжка</p><h1>Ново събитие</h1><p class="muted">Запиши извършена проверка, профилактика или ремонт и по избор актуализирай следващата проверка.</p></div></section>
{% if error %}<div class="alert">{{ error }}</div>{% endif %}
<div class="panel form-panel"><form method="post" action="{{ path('app_management_maintenance_event_new') }}">
    <input type="hidden" name="_token" value="{{ csrf_token('maintenance_event_create') }}">
    <label for="event-asset">Актив</label><select id="event-asset" name="asset_id" required><option value="">Избери актив</option>{% for asset in assets %}<option value="{{ asset.id }}"{% if app.request.request.get('asset_id') == (asset.id ~ '') %} selected{% endif %}>{{ asset.name }} · {{ asset.location }}</option>{% endfor %}</select>
    <label for="event-type">Тип</label><select id="event-type" name="type" required>{% for type in types %}<option value="{{ type.value }}"{% if app.request.request.get('type') == type.value %} selected{% endif %}>{{ type.labelBg() }}</option>{% endfor %}</select>
    <label for="event-date">Дата</label><input id="event-date" type="date" name="performed_at" required value="{{ app.request.request.get('performed_at') }}">
    <label for="event-summary">Описание</label><input id="event-summary" name="summary" maxlength="255" required value="{{ app.request.request.get('summary') }}">
    <label for="event-supplier">Доставчик <span class="muted">(по избор)</span></label><select id="event-supplier" name="supplier_id"><option value="">Без доставчик</option>{% for supplier in suppliers %}<option value="{{ supplier.id }}"{% if app.request.request.get('supplier_id') == (supplier.id ~ '') %} selected{% endif %}>{{ supplier.name }}</option>{% endfor %}</select>
    <label for="event-contract">Договор <span class="muted">(по избор)</span></label><select id="event-contract" name="contract_id"><option value="">Без договор</option>{% for contract in contracts %}<option value="{{ contract.id }}"{% if app.request.request.get('contract_id') == (contract.id ~ '') %} selected{% endif %}>{{ contract.title }}{% if contract.reference %} · {{ contract.reference }}{% endif %}</option>{% endfor %}</select>
    <label for="event-signal">Свързан сигнал <span class="muted">(по избор)</span></label><select id="event-signal" name="signal_id"><option value="">Без сигнал</option>{% for signal in signals %}<option value="{{ signal.id }}"{% if app.request.request.get('signal_id') == (signal.id ~ '') %} selected{% endif %}>#{{ signal.id }} · {{ signal.title }}</option>{% endfor %}</select>
    <label for="event-next-inspection">Следваща проверка <span class="muted">(по избор)</span></label><input id="event-next-inspection" type="date" name="next_inspection_at" value="{{ app.request.request.get('next_inspection_at') }}">
    <label for="event-note">Бележка</label><textarea id="event-note" name="note" rows="5">{{ app.request.request.get('note') }}</textarea>
    <button type="submit" name="event_submit">Запиши събитие</button>
</form></div>
{% endblock %}
