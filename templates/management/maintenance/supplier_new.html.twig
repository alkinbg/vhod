{% extends 'base.html.twig' %}

{% block title %}Нов доставчик · Поддръжка · Vhod{% endblock %}

{% block body %}
<section class="hero"><div><p class="eyebrow">Управление · Поддръжка</p><h1>Нов доставчик</h1><p class="muted">Регистрирай фирма или изпълнител за поддръжка на общите части.</p></div></section>
{% if error %}<div class="alert">{{ error }}</div>{% endif %}
<div class="panel form-panel"><form method="post" action="{{ path('app_management_maintenance_supplier_new') }}">
    <input type="hidden" name="_token" value="{{ csrf_token('maintenance_supplier_create') }}">
    <label for="supplier-name">Име</label><input id="supplier-name" name="name" maxlength="180" required value="{{ app.request.request.get('name') }}">
    <label for="supplier-registration">ЕИК / регистрационен номер</label><input id="supplier-registration" name="registration_number" maxlength="64" value="{{ app.request.request.get('registration_number') }}">
    <label for="supplier-contact">Лице за контакт</label><input id="supplier-contact" name="contact_person" maxlength="160" value="{{ app.request.request.get('contact_person') }}">
    <label for="supplier-email">Имейл</label><input id="supplier-email" type="email" name="email" maxlength="180" value="{{ app.request.request.get('email') }}">
    <label for="supplier-phone">Телефон</label><input id="supplier-phone" name="phone" maxlength="80" value="{{ app.request.request.get('phone') }}">
    <label for="supplier-address">Адрес</label><input id="supplier-address" name="address" maxlength="255" value="{{ app.request.request.get('address') }}">
    <label for="supplier-note">Бележка</label><textarea id="supplier-note" name="note" rows="5">{{ app.request.request.get('note') }}</textarea>
    <button type="submit" name="supplier_submit">Запиши доставчик</button>
</form></div>
{% endblock %}
